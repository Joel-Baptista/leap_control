        - /RobotModelCollisions1
        - /RobotModelCollisions1/Mass Properties1
        - /RobotModel1
      Splitter Ratio: 0.5
    Tree Height: 518
  - Class: rviz_common/Help
    Name: Help
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
