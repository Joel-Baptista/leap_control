<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="leap">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />
    <xacro:arg name="use_gazebo" default="false" />


    <!-- Import leap urdf file -->
    <xacro:include filename="$(find leap_description)/assets/leap_hand/robot.urdf.xacro" />

    <!-- Import control_xacro -->
    
    <xacro:if value="$(arg use_gazebo)">
        <xacro:include filename="leap.gz_control.xacro" />
        <xacro:leap_gz_control name="GazeboSimSystem" initial_positions_file="$(arg initial_positions_file)"/>
        <gazebo>
            <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
                <!-- <parameters>$(arg controllers_yaml)</parameters> -->
                <parameters>/home/joel/distrobox/ros2-ubuntu/leap_ws/src/leap_control/leap_sim/config/leap_controller.yaml</parameters>
            </plugin>
        </gazebo>
    </xacro:if>
    <xacro:unless value="$(arg use_gazebo)">
        <xacro:include filename="leap.ros2_control.xacro" />
        <xacro:leap_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>
    </xacro:unless>


</robot>
