WorldInfo {
  title "LEAP WORLD — pkg leap_sim/worlds/world.wbt"
  basicTimeStep 2
  ERP 0.01 # (Error Reduction Parameter) 
  CFM 1e-3 # (Constraint Force Mixing)

  contactProperties [
    ContactProperties {
      material1          "default"                                                                                             # any string
      material2          "default"                                                                                             # any string
      coulombFriction    1                                                                                                     # [0, inf)
      frictionRotation   0 0                                                                                                   # any positive vector
      rollingFriction    0 0 0                                                                                                 # rolling/spinning friction
      bounce             0.5                                                                                                   # [0, 1]
      bounceVelocity     0.1                                                                                                  # [0, inf)
      forceDependentSlip 0                                                                                                     # [0, inf)
      softERP            0.2                                                                                                   # [0, 1]
      softCFM            0.1                                                                                                 # (0, inf)
      maxContactJoints   15                                                                                                    # (0, inf)
    }
  ]
}



Viewpoint {
  orientation -0.33185733874619844 -0.09874274160469809 0.9381474178937331 3.686018050088086
  position 1.700313773507203 1.0549607538959629 1.4846240848267684
  follow "Leap"
}
TexturedBackground {
}
TexturedBackgroundLight {
}
CircleArena {
}

Leap {
  translation     0 0 0.05
  rotation        0 3.14 0 3.14
  name            "Leap"  # Is `Robot.name`.
  controller      "<extern>"   # Is `Robot.controller`.
  controllerUrl   "ipc://1234:Leap"
  controllerArgs  []       # Is `Robot.controllerArgs`.
  customData      ""       # Is `Robot.customData`.
  supervisor      FALSE    # Is `Robot.supervisor`.
  synchronization TRUE     # Is `Robot.synchronization`.
  selfCollision   TRUE    # Is `Robot.selfCollision`.
  motorPID          200 0 0     # (P, I, D)
  motorMaxVelocity  8.84      # rad/s
  motorMaxTorque    0.95       # N·m
  jointSpringConstant    0.0    
  jointDampingConstant    0.0   
  
}