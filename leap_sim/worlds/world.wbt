#VRML_SIM R2025a utf8

EXTERNPROTO "../protos/Leap.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2022b/projects/objects/floors/protos/CircleArena.proto"

WorldInfo {
  title "LEAP WORLD — pkg leap_sim/worlds/world.wbt"
  basicTimeStep 4
  ERP 0.1 # (Error Reduction Parameter) 
  CFM 1e-2 # (Constraint Force Mixing)

  linearDamping 0.02
  angularDamping 0.04

  contactProperties [
    ContactProperties {
      material1 "default"
      material2 "default"

      coulombFriction 0.6
      bounce 0
      bounceVelocity 100

      softERP 0.1
      softCFM 1e-3      
      maxContactJoints 10
    }
  ]
}

Viewpoint {
  orientation -0.33185733874619844 -0.09874274160469809 0.9381474178937331 3.686018050088086
  position 1.700313773507203 1.0549607538959629 1.4846240848267684
  follow "Leap"
}
TexturedBackground {
}
TexturedBackgroundLight {
}
CircleArena {
}

Leap {
  translation     0 0 0.1
  rotation        0 3.14 0 3.14
  name            "Leap"  # Is `Robot.name`.
  controller      "<extern>"   # Is `Robot.controller`.
  controllerUrl   "ipc://1234:Leap"
  controllerArgs  []       # Is `Robot.controllerArgs`.
  customData      ""       # Is `Robot.customData`.
  supervisor      FALSE    # Is `Robot.supervisor`.
  synchronization TRUE     # Is `Robot.synchronization`.
  selfCollision   TRUE    # Is `Robot.selfCollision`.
  motorPID          20 0 0     # (P, I, D)
  motorMaxVelocity  5.0       # rad/s
  motorMaxTorque    0.3       # N·m
  motorMinPosition -3.14      # rad
  motorMaxPosition  3.14      # rad
  
}