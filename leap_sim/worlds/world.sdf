<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="leap_world">

    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>

        <engine>ogre2</engine>
        <scene>scene</scene>

        <!-- X Y Z Roll Pitch Yaw (meters, radians) -->
        <camera_pose>-0.3 0 0.5 0 0.785 0</camera_pose>
      </plugin>
    </gui>

    <!-- Physics and lighting -->
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <scene>
      <ambient>0.3 0.3 0.3 1</ambient>
      <background>0.7 0.7 0.8 1</background>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>

      <!-- Position/orientation doesn't matter much for directional, but it's fine to set -->
      <pose>0 0 10 0 0 0</pose>

      <diffuse>1 1 1 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>

      <!-- Direction the light shines *towards* -->
      <direction>-0.5 0.2 -1</direction>
    </light>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>

          <material>
            <!-- “base colour” -->
            <ambient>0.05 0.2 0.05 1</ambient>
            <diffuse>0.15 0.6 0.15 1</diffuse>

            <!-- highlights (usually small) -->
            <specular>0.02 0.02 0.02 1</specular>

            <!-- self-glow (usually 0) -->
            <emissive>0 0 0 1</emissive>
          </material>
        </visual>

      </link>
    </model>

    <!-- Example custom model -->
    <include>
      <uri>model://robot.urdf.xacro</uri>
      <pose>0 0 0.1 3.14 0 0</pose>
    </include>
    <!-- Optional: Sensors, static models, walls, etc. -->
  </world>
</sdf>
